# Venn environment variables. Copy to .env and fill in. Never commit the real .env.
#
# Venn looks for .env in two places, in this order:
#   1. this repository folder
#   2. the folder one level above this repository
# Real environment variables override both files.

# Course-provided Portkey key (used with gpt-6-luna only).
# Leave empty to run Venn with AI features disabled.
PORTKEY_API_KEY=your-portkey-key-here

# Optional (defaults shown). Uncomment to change.
# DATABASE_URL=sqlite:///data/venn.db
# COOKIE_SECURE=false
